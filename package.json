{
  "name": "slopsearcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "search": "tsx src/cli/search.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "drive:auth": "tsx src/cli/drive-auth.ts",
    "backup": "tsx src/cli/backup.ts",
    "test": "vitest run",
    "health": "node dist/cli/health.js",
    "format": "prettier --write src scripts *.json *.md *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src scripts *.json *.md *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.3.0",
    "pdf-parse": "^2.4.5",
    "read-excel-file": "^9.3.12",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
