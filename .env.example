# Copy to .env and chmod 600 .env. Use Node.js 24+.
DB_PATH=./data/slopsearcher.db

# Discord Developer Portal > Bot. Enable Message Content Intent.
DISCORD_TOKEN=
# Right-click your Discord server > Copy Server ID (enable Developer Mode).
DISCORD_GUILD_ID=
# Optional comma-separated channel IDs. Empty: every readable project channel.
# A parent channel ID includes its threads. Exclusions take precedence.
DISCORD_CHANNEL_IDS=
DISCORD_EXCLUDED_CHANNEL_IDS=
DISCORD_SLOPSEARCHES_CATEGORY=Slopsearcher Long-Running

# Everyone in the configured server may start research by default.
# To restrict it, set false and fill one or both allowlists.
RESEARCH_EVERYONE=true
RESEARCH_ALLOWED_ROLE_IDS=
RESEARCH_ALLOWED_USER_IDS=
USER_COOLDOWN_SECONDS=0
MAX_PENDING_TASKS=50
RESEARCH_CONCURRENCY=2
RESEARCH_MAX_TURNS=6
RUNNER_TIMEOUT_SECONDS=1800

# Optional Google Drive integration. Pick folders by ID from their Drive URLs.
# Source subfolders are included. Reports are saved as Markdown files.
DRIVE_SOURCE_FOLDER_ID=
DRIVE_REPORTS_FOLDER_ID=
# Create a Desktop OAuth client in Google Cloud, enable Drive API, then run:
# npm run drive:auth -- --manual
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
GOOGLE_TOKEN_PATH=./data/google-token.json
DRIVE_MAX_FILE_MB=20
MAX_SOURCE_CHARACTERS=200000

# Codex CLI 0.159.2+ must be installed and signed in as the service user.
# Keep this dedicated profile separate from your development Codex profile.
# CODEX_HOME=./data/codex codex login --device-auth
CODEX_BIN=codex
SLOP_CODEX_HOME=./data/codex
# Model and reasoning effort used for questions, research, and memory extraction.
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=max
WEB_SEARCH=true
# Public-page Chromium browsing and screenshot attachments (no inbound ports).
# Install its browser: npx playwright install chromium --only-shell
BROWSER_ENABLED=true
# Optional custom Chromium executable; sandbox support is required.
BROWSER_EXECUTABLE_PATH=
# Optional library directory for a Chromium runtime installed without root.
BROWSER_LIBRARY_PATH=
BROWSER_MAX_ACTIONS=15
BROWSER_SCREENSHOT_RETENTION_DAYS=7

SYNC_INTERVAL_SECONDS=300
RECONCILE_INTERVAL_SECONDS=86400
BACKFILL_PAGE_SIZE=100
BACKFILL_CONCURRENCY=2
MEMORY_ENABLED=true
MEMORY_INTERVAL_SECONDS=900
MEMORY_BATCH_SIZE=30
BACKUP_INTERVAL_HOURS=24
LOG_LEVEL=info
