# --- storage -----------------------------------------------------------------
# Single SQLite file. Mount this path on a persistent volume; nothing else in the
# service holds state, which is what keeps the hosting decision open.
DB_PATH=./data/slopsearcher.db

# --- discord -----------------------------------------------------------------
# Bot token. The application MUST have the privileged Message Content Intent
# enabled in the Discord developer portal, or indexing returns empty message bodies.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated channel IDs to index. Empty means "every text channel the bot
# can read in the guild".
DISCORD_CHANNEL_IDS=
# Category name that long-running investigation channels are created under.
DISCORD_SLOPSEARCHES_CATEGORY=slopsearches

# --- google drive (phase 3) ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback
GOOGLE_TOKEN_PATH=./data/google-token.json
DRIVE_SOURCE_FOLDER_ID=
DRIVE_REPORTS_FOLDER_ID=

# --- research runner (phase 2) ------------------------------------------------
# Path to the Codex CLI. Install with: npm i -g @openai/codex
CODEX_BIN=codex

# --- tuning -------------------------------------------------------------------
# Messages fetched per Discord history page during backfill (Discord caps at 100).
BACKFILL_PAGE_SIZE=100
# How many channels backfill concurrently.
BACKFILL_CONCURRENCY=3
# A per-channel extraction window closes after this many idle seconds...
EXTRACT_WINDOW_IDLE_SECONDS=900
# ...or once it holds this many messages, whichever comes first.
EXTRACT_WINDOW_MAX_MESSAGES=80

LOG_LEVEL=info
